# Kopiere diese Datei nach ".env" und trage deine eigenen Werte ein.
# .env steht in .gitignore und wird NIE eingecheckt. Leere Werte = Dienst deaktiviert.

# --- Claude (nur nötig für llm.backend = "anthropic_api"; die Claude-CLI nutzt dein Login) ---
ANTHROPIC_API_KEY=

# --- YouTube Data API (Upload als PRIVAT) ---
# Client-ID/Secret aus der Google Cloud Console (OAuth-Client "Desktop-App"),
# Refresh-Token mit:  python scripts/youtube_auth.py
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Meta (Facebook-Seite, Reel als ENTWURF in der Business Suite) ---
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Buffer (Post als ENTWURF) ---
BUFFER_API_KEY=
# Kommagetrennte Channel-IDs aus deinem Buffer-Konto
BUFFER_CHANNEL_IDS=
BUFFER_API_URL=https://api.buffer.com

# Öffentliche Basis-URL dieses Tools (z. B. kostenloser Cloudflare-Quick-Tunnel),
# damit Buffer die Videodatei abrufen kann. Beispiel: https://abc-xyz.trycloudflare.com
PUBLIC_BASE_URL=
